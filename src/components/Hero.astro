---
import { Image } from "astro:assets";
import heroBg from "../assets/images/hero-original.png";
import drapeauReunion from "../assets/images/drapeau-reunion.png"; // Ton image PNG sans fond de la Réunion
---

<section
    class="relative min-h-[85vh] flex items-center overflow-hidden bg-foret"
>
    <!-- Image de fond Hero -->
    <Image
        src={heroBg}
        alt="Carry traditionnel réunionnais au coucher de soleil - La Cuisine du Mafatais Toulouse"
        class="absolute inset-0 w-full h-full object-cover object-center"
        loading="eager"
        fetchpriority="high"
        widths={[640, 1024, 1600, 2000]}
        sizes="100vw"
    />

    <!-- Overlay dégradé gauche -> droite (préserve le centre et le coucher de soleil) -->
    <div
        class="absolute inset-0 bg-gradient-to-r from-black/85 via-black/50 to-transparent"
        aria-hidden="true"
    >
    </div>

    <!-- Badge "RECETTES PÉI 100% Authentique" EXACT (Fond crème, arrondi, incliné) -->
    <div
        class="absolute top-6 right-6 md:top-10 md:right-12 z-20 transform rotate-[6deg] shadow-2xl transition-transform hover:rotate-0"
    >
        <div
            class="bg-[#F9F6EE] px-5 py-3 rounded-2xl flex items-center gap-3.5 border border-white/40 backdrop-blur-sm"
        >
            <!-- Image PNG sans fond de la Réunion -->
            <Image
                src={drapeauReunion}
                alt="Île de La Réunion"
                class="w-9 h-auto object-contain drop-shadow-sm"
                width={36}
                height={36}
            />

            <!-- Textes identiques à la maquette -->
            <div class="text-left pr-1">
                <span
                    class="block text-[10px] uppercase tracking-widest font-extrabold text-[#526058] leading-tight"
                >
                    RECETTES PÉI
                </span>
                <span
                    class="block text-[15px] font-serif font-black text-foret leading-none mt-0.5"
                >
                    100% Authentique
                </span>
            </div>
        </div>
    </div>

    <!-- Contenu principal aligné à gauche -->
    <div class="relative z-10 max-w-7xl mx-auto px-6 py-16 w-full">
        <div class="max-w-xl space-y-6">
            <!-- Eyebrow SEO/GEO -->
            <div
                class="inline-block bg-black/40 border border-safran/40 backdrop-blur-md px-3.5 py-1.5 rounded-full"
            >
                <span
                    class="text-safran font-bold text-xs uppercase tracking-widest"
                >
                    Cuisine Créole Traditionnelle • Toulouse (31)
                </span>
            </div>

            <!-- Titre H1 -->
            <h1
                class="text-4xl sm:text-6xl font-serif font-bold text-sable leading-tight drop-shadow-lg"
            >
                L’esprit du Péi, <br />
                <span class="text-safran">le goût du vrai Carry.</span>
            </h1>

            <!-- Description SEO Local -->
            <p
                class="text-sable/95 text-base sm:text-lg leading-relaxed font-normal drop-shadow"
            >
                Toute l'authenticité de l'Île de La Réunion à Toulouse. Des
                recettes ancestrales, mijotées selon la pure tradition
                réunionnaise.
            </p>

            <!-- CTAs -->
            <div class="flex flex-col sm:flex-row items-center gap-4 pt-3">
                <a
                    href="/devis-traiteur"
                    class="w-full sm:w-auto bg-safran text-foret font-bold text-xs uppercase tracking-wider px-8 py-4 rounded-full shadow-xl hover:bg-sable hover:text-foret transition-all text-center"
                >
                    Demander un devis
                </a>

                <a
                    href="#specialites"
                    class="w-full sm:w-auto border-2 border-sable/80 bg-black/30 backdrop-blur-sm text-sable font-bold text-xs uppercase tracking-wider px-8 py-4 rounded-full hover:bg-sable hover:text-foret transition-all text-center"
                >
                    Voir nos spécialités
                </a>
            </div>
        </div>
    </div>
</section>

<!-- JSON-LD IA & SEO Local -->
<script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "CateringService",
        "name": "La Cuisine du Mafatais",
        "description": "Traiteur réunionnais à Toulouse. Carrys, Rougails, Sarcives et Samoussas faits maison.",
        "url": "https://lacuisinedumafatais.fr",
        "telephone": "+33635304659",
        "areaServed": "Toulouse et Haute-Garonne (31)",
        "servesCuisine": "Réunionnaise"
    }
</script>
