---
import { Image } from "astro:assets";
import imgLogo from "../assets/images/logo.png";
const currentYear = new Date().getFullYear();

const navPlats = [
    { name: "Carrys & Rougails", path: "/nos-plats/carrys-et-rougails" },
    { name: "Sarcives & Fumoir", path: "/nos-plats/sarcives-fumoir" },
    { name: "Samoussas & Bouchons", path: "/nos-plats/samoussas-bouchons" },
];

const villesIntervention = [
    "Toulouse",
    "Blagnac",
    "Colomiers",
    "Tournefeuille",
    "Muret",
    "Balma",
    "Ramonville",
    "Labège",
];
---

<footer class="bg-foret text-sable py-14 border-t border-safran/30">
    <div
        class="max-w-7xl mx-auto px-6 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 mb-12"
    >
        <!-- Col 1 : Identité & GEO Local -->
        <div class="space-y-4">
            <div class="flex items-center gap-3">
                <Image
                    src={imgLogo}
                    alt="La Cuisine du Mafatais - Traiteur Réunionnais Toulouse"
                    class="w-12 h-12 rounded-full border border-safran object-cover"
                />
                <div>
                    <span
                        class="block font-serif font-bold text-lg text-safran leading-tight"
                        >La Cuisine du Mafatais</span
                    >
                    <span
                        class="block text-[11px] uppercase tracking-wider text-sable/90"
                        >Traiteur Réunionnais</span
                    >
                </div>
            </div>

            <p class="text-xs text-sable leading-relaxed">
                Spécialités créoles authentiques & faits-maison. Présent sur les
                marchés de Toulouse et disponible pour tous vos événements
                privés ou professionnels en Haute-Garonne (31).
            </p>

            <div class="pt-2">
                <span
                    class="block text-[11px] font-bold text-safran uppercase tracking-wider mb-1.5"
                    >Zone d'intervention :</span
                >
                <p class="text-[11px] text-sable leading-normal">
                    {villesIntervention.join(" • ")} et l'ensemble de la métropole
                    toulousaine.
                </p>
            </div>
        </div>

        <!-- Col 2 : Maillage Interne -->
        <div>
            <h2
                class="font-serif font-bold text-safran text-sm uppercase tracking-wider mb-4 border-b border-safran/30 pb-2"
            >
                Nos Spécialités
            </h2>
            <ul class="space-y-2.5 text-xs text-sable">
                {
                    navPlats.map((plat) => (
                        <li>
                            <a
                                href={plat.path}
                                class="hover:text-safran underline-offset-2 hover:underline transition-colors flex items-center gap-1.5"
                            >
                                <span
                                    class="text-safran text-xs"
                                    aria-hidden="true"
                                >
                                    ›
                                </span>{" "}
                                {plat.name}
                            </a>
                        </li>
                    ))
                }
                <li class="pt-2">
                    <a
                        href="/devis-traiteur"
                        class="inline-block bg-safran text-foret font-bold px-3.5 py-2 rounded-lg hover:bg-sable hover:text-foret transition-all text-xs"
                    >
                        Demander un devis traiteur
                    </a>
                </li>
            </ul>
        </div>

        <!-- Col 3 : Contact Direct -->
        <div>
            <h2
                class="font-serif font-bold text-safran text-sm uppercase tracking-wider mb-4 border-b border-safran/30 pb-2"
            >
                Contact & Commandes
            </h2>
            <ul class="space-y-3 text-xs text-sable">
                <li class="flex items-start gap-2.5">
                    <span class="text-safran" aria-hidden="true">📞</span>
                    <div>
                        <span
                            class="block text-[10px] text-sable/90 uppercase font-semibold"
                            >Téléphone</span
                        >
                        <a
                            href="tel:0635304659"
                            class="font-bold text-sable hover:text-safran transition-colors"
                            >06 35 30 46 59</a
                        >
                    </div>
                </li>
                <li class="flex items-start gap-2.5">
                    <span class="text-safran" aria-hidden="true">✉️</span>
                    <div>
                        <span
                            class="block text-[10px] text-sable/90 uppercase font-semibold"
                            >Email</span
                        >
                        <a
                            href="mailto:mafatais97490@gmail.com"
                            class="font-bold text-sable hover:text-safran transition-colors"
                            >mafatais97490@gmail.com</a
                        >
                    </div>
                </li>
                <li class="flex items-start gap-2.5">
                    <span class="text-safran" aria-hidden="true">📍</span>
                    <div>
                        <span
                            class="block text-[10px] text-sable/90 uppercase font-semibold"
                            >Secteur</span
                        >
                        <span>Toulouse & Haute-Garonne (31)</span>
                    </div>
                </li>
            </ul>
        </div>

        <!-- Col 4 : Législation & Navigation -->
        <div>
            <h2
                class="font-serif font-bold text-safran text-sm uppercase tracking-wider mb-4 border-b border-safran/30 pb-2"
            >
                Informations
            </h2>
            <ul class="space-y-2.5 text-xs text-sable">
                <li>
                    <a
                        href="/"
                        class="hover:text-safran underline-offset-2 hover:underline transition-colors"
                        >Accueil</a
                    >
                </li>
                <li>
                    <a
                        href="/mentions-legales"
                        class="hover:text-safran underline-offset-2 hover:underline transition-colors"
                        >Mentions Légales</a
                    >
                </li>
                <li>
                    <a
                        href="/politique-de-confidentialite"
                        class="hover:text-safran underline-offset-2 hover:underline transition-colors"
                        >Politique de Confidentialité</a
                    >
                </li>
            </ul>
        </div>
    </div>

    <!-- Barre de copyright et signature -->
    <div
        class="max-w-7xl mx-auto px-6 pt-8 border-t border-safran/25 flex flex-col sm:flex-row justify-between items-center text-xs text-sable/80 gap-4 text-center sm:text-left"
    >
        <p>© {currentYear} La Cuisine du Mafatais. Tous droits réservés.</p>
        <p>
            Site créé avec <span class="text-terracotta">❤️</span> par
            <a
                href="https://www.loicpoosing.fr/"
                target="_blank"
                rel="noopener noreferrer"
                class="font-semibold text-sable hover:text-safran transition-colors underline underline-offset-4 ml-1"
            >
                Loïc Poo-Sing
            </a>
        </p>
    </div>
</footer>

<!-- JSON-LD SEO Local / GEO -->
<script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "CateringService",
        "name": "La Cuisine du Mafatais",
        "image": "https://lacuisinedumafatais.fr/images/logo.png",
        "telephone": "+33635304659",
        "email": "mafatais97490@gmail.com",
        "priceRange": "€€",
        "servesCuisine": "Réunionnaise",
        "address": {
            "@type": "PostalAddress",
            "addressLocality": "Toulouse",
            "addressRegion": "Haute-Garonne",
            "addressCountry": "FR"
        },
        "areaServed": [
            "Toulouse",
            "Blagnac",
            "Colomiers",
            "Tournefeuille",
            "Muret",
            "Balma",
            "Haute-Garonne"
        ],
        "description": "Traiteur réunionnais et spécialités créoles fait-maison sur les marchés de Toulouse et pour événements privés et professionnels."
    }
</script>
