---
/* Code Astro si besoin */
---

<header
    class="sticky top-0 z-50 bg-sable/90 backdrop-blur-md border-b border-foret/10"
>
    <div class="max-w-7xl mx-auto px-6 py-3 flex items-center justify-between">
        <a href="/" class="flex items-center gap-3">
            <img
                src="/images/logo.png"
                alt="Logo La Cuisine du Mafatais"
                class="h-12 w-auto rounded-full shadow-sm"
            />
            <div>
                <span
                    class="text-lg font-serif font-bold text-foret tracking-wide block leading-none"
                >
                    La Cuisine du Mafatais
                </span>
                <span
                    class="text-safran text-[10px] uppercase tracking-widest font-sans font-semibold"
                >
                    974 • Toulouse
                </span>
            </div>
        </a>

        <nav class="hidden md:flex items-center space-x-8 font-medium text-sm">
            <a href="#tradition" class="hover:text-safran transition-colors"
                >La Tradition</a
            >
            <a href="#carte" class="hover:text-safran transition-colors"
                >Nos Plats</a
            >
            <a href="#marches" class="hover:text-safran transition-colors"
                >Nos Marchés</a
            >
            <a
                href="#traiteur"
                class="px-5 py-2.5 bg-foret text-sable rounded-full hover:bg-foret-light transition-colors shadow-sm"
            >
                Devis Traiteur
            </a>
        </nav>
    </div>
</header>
