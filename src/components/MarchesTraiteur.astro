---
import { Image } from "astro:assets";
import imgStandJimmy from "../assets/images/stand-jimmy.jpg";
---

<section id="marches" class="py-20 px-6 max-w-7xl mx-auto">
    <div class="grid lg:grid-cols-2 gap-12 items-center">
        <!-- Colonne Gauche : Photo Jimmy / Marchés avec overlay d'harmonisation -->
        <div class="relative group">
            <div
                class="rounded-3xl overflow-hidden shadow-xl border border-foret/10 relative"
            >
                <!-- Photo optimisée avec filtre chaud léger -->
                <Image
                    src={imgStandJimmy}
                    alt="Jimmy sur le marché de Tournefeuille proposant des spécialités réunionnaises"
                    class="w-full h-[480px] object-cover object-center filter brightness-95 contrast-[1.03] sepia-[0.10]"
                    widths={[500, 800, 1024]}
                    sizes="(max-width: 1024px) 100vw, 600px"
                    loading="lazy"
                />
                <!-- Overlay teinté chaud/sombre pour fondre l'image dans la charte -->
                <div
                    class="absolute inset-0 bg-gradient-to-t from-foret/60 via-foret/10 to-transparent mix-blend-multiply pointer-events-none"
                >
                </div>
            </div>

            <!-- Macaron citation -->
            <div
                class="absolute -bottom-6 -right-4 md:right-6 bg-safran text-foret p-6 rounded-2xl shadow-2xl max-w-xs hidden sm:block border border-white/30 transform group-hover:-translate-y-1 transition-transform"
            >
                <p class="font-serif font-bold text-base leading-snug">
                    "Servir la vraie cuisine de chez nous, sans chichis mais
                    avec passion."
                </p>
                <span
                    class="text-[10px] uppercase tracking-widest font-bold block mt-2 opacity-80"
                >
                    — L'équipe Mafatais
                </span>
            </div>
        </div>

        <!-- Colonne Droite : Infos Marchés & Bouton Traiteur -->
        <div class="space-y-6">
            <span
                class="text-xs font-bold text-safran uppercase tracking-widest block"
            >
                Proximité & Convivialité
            </span>
            <h2
                class="text-3xl md:text-5xl font-serif text-foret leading-tight"
            >
                Retrouvez-nous sur les marchés de Toulouse
            </h2>
            <p class="text-foret/80 leading-relaxed font-normal">
                Chaque semaine, retrouvez nos marmites fumantes sur le marché de
                plein vent de <strong>Tournefeuille</strong> (Allées des Sports) le
                <strong>dimanche de 7h00 à 14h00</strong>. L'occasion idéale
                pour sentir les effluves de gingembre, de curcuma et repartir
                avec vos plats chauds tout prêts.
            </p>

            <!-- Bloc Traiteur / Privatisation -->
            <div
                id="traiteur"
                class="mt-8 p-6 rounded-2xl bg-sable-dark/60 border border-foret/10 space-y-4"
            >
                <div class="flex items-center gap-3">
                    <div
                        class="w-10 h-10 rounded-full bg-foret text-sable flex items-center justify-center font-serif font-bold text-lg shrink-0"
                    >
                        974
                    </div>
                    <div>
                        <h3 class="font-serif font-bold text-foret text-lg">
                            Un événement privé ou d'entreprise ?
                        </h3>
                        <p class="text-xs text-foret/70">
                            Mariages, anniversaires, repas d'affaires à Toulouse
                            & Haute-Garonne.
                        </p>
                    </div>
                </div>
                <p class="text-sm text-foret/80">
                    Nous vous proposons un service traiteur créole sur-mesure :
                    buffets d'apéritifs créoles, repas chauds servis à la
                    marmite ou prestations clés en main.
                </p>
                <a
                    href="/devis-traiteur"
                    class="inline-flex items-center gap-2 px-6 py-3 bg-foret text-sable rounded-full hover:bg-foret-light transition-all text-sm font-semibold shadow-md group"
                >
                    Demander un devis personnalisé
                    <span
                        class="group-hover:translate-x-1 transition-transform"
                        aria-hidden="true">→</span
                    >
                </a>
            </div>
        </div>
    </div>
</section>
