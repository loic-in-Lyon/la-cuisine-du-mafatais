---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
---

<Layout
    title="Traiteur Réunionnais & Buffet Créole à Toulouse | Devis Gratuit | La Cuisine du Mafatais"
    description="Service traiteur réunionnais sur-mesure à Toulouse et en Haute-Garonne. Repas de groupe, mariages, anniversaires et événements d'entreprise. Devis gratuit."
>
    <Navbar />

    <main class="py-12 md:py-20">
        <div class="max-w-7xl mx-auto px-6">
            <!-- Fil d'Ariane -->
            <nav class="text-xs text-foret/60 mb-8 flex items-center gap-2">
                <a href="/" class="hover:text-safran transition-colors"
                    >Accueil</a
                >
                <span>/</span>
                <span class="text-foret font-semibold">Prestation Traiteur</span
                >
            </nav>

            <!-- Hero Traiteur -->
            <div class="grid lg:grid-cols-2 gap-12 items-center mb-16">
                <div>
                    <span
                        class="text-xs font-bold text-safran uppercase tracking-widest block mb-2"
                        >Événements & Réceptions</span
                    >
                    <h1
                        class="text-3xl md:text-5xl font-serif font-bold text-foret leading-tight mb-4"
                    >
                        Traiteur Créole pour Vos Événements à Toulouse
                    </h1>
                    <p
                        class="text-base md:text-lg text-foret/80 font-light leading-relaxed mb-6"
                    >
                        Vous organisez un mariage, un anniversaire, une
                        cousinade ou un repas d'entreprise ? Apportez la chaleur
                        et la convivialité des grands repas de famille
                        réunionnais à vos invités.
                    </p>

                    <div class="space-y-3 text-sm text-foret/80">
                        <div class="flex items-center gap-3">
                            <span
                                class="w-6 h-6 rounded-full bg-safran/20 text-safran font-bold flex items-center justify-center text-xs"
                                >✓</span
                            >
                            <span
                                ><strong
                                    >Marmites géantes traditionnelles</strong
                                > servies chaudes sur place</span
                            >
                        </div>
                        <div class="flex items-center gap-3">
                            <span
                                class="w-6 h-6 rounded-full bg-safran/20 text-safran font-bold flex items-center justify-center text-xs"
                                >✓</span
                            >
                            <span
                                ><strong>Formules sur-mesure :</strong> Cocktail apéritif,
                                plat chaud en marmite & desserts</span
                            >
                        </div>
                        <div class="flex items-center gap-3">
                            <span
                                class="w-6 h-6 rounded-full bg-safran/20 text-safran font-bold flex items-center justify-center text-xs"
                                >✓</span
                            >
                            <span
                                >De <strong>15 à plus de 150 personnes</strong> à
                                Toulouse et en Haute-Garonne</span
                            >
                        </div>
                    </div>
                </div>

                <div
                    class="rounded-3xl overflow-hidden shadow-2xl border border-foret/10 h-[380px] md:h-[450px]"
                >
                    <img
                        src="/images/stand-marche.jpg"
                        alt="Service traiteur La Cuisine du Mafatais"
                        class="w-full h-full object-cover"
                    />
                </div>
            </div>

            <!-- Formulaire de Devis Traiteur avec Web3Forms -->
            <div
                class="bg-sable-dark/40 rounded-3xl p-8 md:p-12 border border-foret/10 max-w-4xl mx-auto shadow-xl"
            >
                <div class="text-center mb-10">
                    <span
                        class="text-xs font-bold text-terracotta uppercase tracking-widest block mb-1"
                        >Sans engagement</span
                    >
                    <h2
                        class="text-2xl md:text-3xl font-serif font-bold text-foret mb-2"
                    >
                        Demander un Devis Gratuit
                    </h2>
                    <p class="text-xs md:text-sm text-foret/70">
                        Remplissez le formulaire ci-dessous. Nous vous répondons
                        sous 24h à 48h.
                    </p>
                </div>

                <form
                    action="https://api.web3forms.com/submit"
                    method="POST"
                    class="space-y-6"
                >
                    <!-- Clé d'accès Web3Forms -->
                    <input
                        type="hidden"
                        name="access_key"
                        value="TON_ACCESS_KEY_WEB3FORMS"
                    />
                    <input
                        type="hidden"
                        name="subject"
                        value="Nouvelle demande de devis traiteur - La Cuisine du Mafatais"
                    />
                    <input
                        type="hidden"
                        name="from_name"
                        value="La Cuisine du Mafatais Website"
                    />

                    <!-- Nom & Email -->
                    <div class="grid md:grid-cols-2 gap-6">
                        <div>
                            <label
                                class="block text-xs font-bold text-foret uppercase tracking-wider mb-2"
                                >Nom & Prénom *</label
                            >
                            <input
                                type="text"
                                name="nom"
                                required
                                placeholder="Ex: Jean Dupont"
                                class="w-full px-4 py-3 rounded-xl bg-sable border border-foret/20 text-sm text-foret focus:outline-none focus:border-safran"
                            />
                        </div>
                        <div>
                            <label
                                class="block text-xs font-bold text-foret uppercase tracking-wider mb-2"
                                >Email *</label
                            >
                            <input
                                type="email"
                                name="email"
                                required
                                placeholder="Ex: jean.dupont@exemple.fr"
                                class="w-full px-4 py-3 rounded-xl bg-sable border border-foret/20 text-sm text-foret focus:outline-none focus:border-safran"
                            />
                        </div>
                    </div>

                    <!-- Téléphone & Type d'événement -->
                    <div class="grid md:grid-cols-2 gap-6">
                        <div>
                            <label
                                class="block text-xs font-bold text-foret uppercase tracking-wider mb-2"
                                >Téléphone *</label
                            >
                            <input
                                type="tel"
                                name="telephone"
                                required
                                placeholder="Ex: 06 35 30 46 59"
                                class="w-full px-4 py-3 rounded-xl bg-sable border border-foret/20 text-sm text-foret focus:outline-none focus:border-safran"
                            />
                        </div>
                        <div>
                            <label
                                class="block text-xs font-bold text-foret uppercase tracking-wider mb-2"
                                >Type d'événement *</label
                            >
                            <select
                                name="type_evenement"
                                class="w-full px-4 py-3 rounded-xl bg-sable border border-foret/20 text-sm text-foret focus:outline-none focus:border-safran"
                            >
                                <option>Anniversaire / Fête de famille</option>
                                <option>Mariage / Retour de mariage</option>
                                <option>Repas d'entreprise / Séminaire</option>
                                <option
                                    >Autre événement privé / Associatif</option
                                >
                            </select>
                        </div>
                    </div>

                    <!-- Date, Nombre de personnes & Lieu -->
                    <div class="grid md:grid-cols-3 gap-6">
                        <div>
                            <label
                                class="block text-xs font-bold text-foret uppercase tracking-wider mb-2"
                                >Date prévue *</label
                            >
                            <input
                                type="date"
                                name="date_evenement"
                                required
                                class="w-full px-4 py-3 rounded-xl bg-sable border border-foret/20 text-sm text-foret focus:outline-none focus:border-safran"
                            />
                        </div>
                        <div>
                            <label
                                class="block text-xs font-bold text-foret uppercase tracking-wider mb-2"
                                >Nombre d'invités *</label
                            >
                            <input
                                type="number"
                                name="nombre_invites"
                                min="10"
                                placeholder="Ex: 40"
                                required
                                class="w-full px-4 py-3 rounded-xl bg-sable border border-foret/20 text-sm text-foret focus:outline-none focus:border-safran"
                            />
                        </div>
                        <div>
                            <label
                                class="block text-xs font-bold text-foret uppercase tracking-wider mb-2"
                                >Lieu / Ville *</label
                            >
                            <input
                                type="text"
                                name="lieu"
                                placeholder="Ex: Toulouse, Blagnac..."
                                required
                                class="w-full px-4 py-3 rounded-xl bg-sable border border-foret/20 text-sm text-foret focus:outline-none focus:border-safran"
                            />
                        </div>
                    </div>

                    <!-- Message -->
                    <div>
                        <label
                            class="block text-xs font-bold text-foret uppercase tracking-wider mb-2"
                            >Plats souhaités & Précisions</label
                        >
                        <textarea
                            name="message"
                            rows="4"
                            placeholder="Précisez votre besoin (ex: Cocktail apéritif samoussas/bouchons + Carry Poulet et Rougail Saucisse en plat chaud...)"
                            class="w-full px-4 py-3 rounded-xl bg-sable border border-foret/20 text-sm text-foret focus:outline-none focus:border-safran"
                        ></textarea>
                    </div>

                    <button
                        type="submit"
                        class="w-full py-4 bg-safran text-foret font-bold rounded-xl hover:bg-safran-hover transition-all text-center shadow-lg uppercase tracking-wider text-sm cursor-pointer"
                    >
                        Envoyer ma demande de devis
                    </button>
                </form>

                <!-- Contact Direct Rapide avec les vraies coordonnées -->
                <div class="mt-12 text-center border-t border-foret/10 pt-8">
                    <p class="text-xs md:text-sm text-foret/70 mb-3">
                        Une question sur les marchés, une réservation de portion
                        ou un renseignement rapide ?
                    </p>
                    <div
                        class="flex flex-col sm:flex-row justify-center items-center gap-4 text-xs md:text-sm font-bold text-foret"
                    >
                        <a
                            href="tel:0635304659"
                            class="flex items-center gap-2 hover:text-safran transition-colors"
                        >
                            <span>📞</span> 06 35 30 46 59
                        </a>
                        <span class="hidden sm:inline text-foret/30">•</span>
                        <a
                            href="mailto:mafatais97490@gmail.com"
                            class="flex items-center gap-2 hover:text-safran transition-colors"
                        >
                            <span>✉️</span> mafatais97490@gmail.com
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <Footer />
</Layout>
