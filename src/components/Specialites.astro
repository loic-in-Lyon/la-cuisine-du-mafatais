---
import { Image } from "astro:assets";

// Importation des images pour l'optimisation automatique Astro (Ajuste les chemins si besoin)
import imgMarmites from "../assets/images/specialites-reunionnaises.webp";
import imgSarcive from "../assets/images/sarcive.jpg";
import imgBouchons from "../assets/images/bouchons-samoussas.jpeg";
import imgMarche from "../assets/images/stand-marche.jpg";
---

<section id="carte" class="py-20 bg-sable-dark/40 border-y border-foret/5">
    <div class="max-w-7xl mx-auto px-6">
        <!-- En-tête de section -->
        <div class="text-center max-w-2xl mx-auto mb-16">
            <span
                class="text-xs font-bold text-safran uppercase tracking-widest block mb-2"
            >
                Savoir-faire Créole
            </span>
            <h2 class="text-3xl md:text-5xl font-serif text-foret mb-4">
                À la Carte & Sur le Marché
            </h2>
            <p class="text-foret/70 text-base">
                Marmites traditionnelles, spécialités au fumoir et street-food
                faite maison.
            </p>
        </div>

        <!-- 1. Grande Card Hero Premium : Marmites & Plats du Jour -->
        <a
            href="/nos-plats/carrys-et-rougails"
            class="group mb-8 block rounded-3xl overflow-hidden shadow-xl relative min-h-[380px] md:min-h-[420px] border border-foret/10"
        >
            <Image
                src={imgMarmites}
                alt="Marmites réunionnaises traditionnelles avec carry poulet et rougail saucisse"
                class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
                widths={[640, 1024, 1500]}
                sizes="(max-width: 1024px) 100vw, 1200px"
                loading="lazy"
            />
            <div
                class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/40 to-black/10 flex items-end p-8 md:p-12"
            >
                <div class="max-w-2xl">
                    <span
                        class="px-3.5 py-1.5 rounded-full bg-safran text-foret text-[11px] font-bold uppercase tracking-wider inline-block mb-3 shadow-md"
                    >
                        Plats Phares & Marmites
                    </span>
                    <h3
                        class="text-white font-serif text-2xl md:text-4xl font-bold mb-3 leading-tight group-hover:text-safran transition-colors"
                    >
                        Carrys, Rougails & Sautés Traditionnels
                    </h3>
                    <p
                        class="text-sable/90 text-sm md:text-base leading-relaxed mb-4 font-light"
                    >
                        Les incontournables de l'île : Carry Poulet, Rougail
                        Saucisse fumé et Sauté de poulet aux légumes. Tous nos
                        plats sont servis avec leur riz basmati, grains et
                        rougail piment.
                    </p>
                    <span
                        class="inline-flex items-center gap-2 text-xs font-bold text-safran group-hover:translate-x-1 transition-transform"
                    >
                        Découvrir les plats & tarifs <span aria-hidden="true"
                            >→</span
                        >
                    </span>
                </div>
            </div>
        </a>

        <!-- 2. Les 3 cartes complémentaires -->
        <div class="grid md:grid-cols-3 gap-8">
            <!-- Carte 1 : Sarcives & Fumoir -->
            <a
                href="/nos-plats/sarcives-fumoir"
                class="group bg-sable rounded-2xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 border border-foret/5 flex flex-col"
            >
                <div class="overflow-hidden h-48 relative">
                    <Image
                        src={imgSarcive}
                        alt="Sarcives de porc marinées et grillades réunionnaises au fumoir"
                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                        widths={[400, 800]}
                        sizes="(max-width: 768px) 100vw, 33vw"
                        loading="lazy"
                    />
                    <span
                        class="absolute top-3 left-3 bg-terracotta text-white text-[10px] font-bold px-2.5 py-1 rounded-full uppercase tracking-wider"
                    >
                        Spécialités Fumoir
                    </span>
                </div>
                <div class="p-6 flex-1 flex flex-col justify-between">
                    <div>
                        <span
                            class="text-[10px] font-bold text-terracotta uppercase tracking-wider block mb-1"
                        >
                            Rôti & Mariné
                        </span>
                        <h3
                            class="text-lg font-serif text-foret font-bold mb-2 group-hover:text-safran transition-colors"
                        >
                            Sarcives & Grillades
                        </h3>
                        <p class="text-xs text-foret/70 leading-relaxed mb-4">
                            Ribs, filet mignon et poulet fermier Label Rouge
                            cuits au fumoir avec notre marinade secrète.
                        </p>
                    </div>
                    <span
                        class="text-xs font-bold text-foret group-hover:translate-x-1 transition-transform inline-flex items-center gap-1"
                    >
                        Voir les grillades <span aria-hidden="true">→</span>
                    </span>
                </div>
            </a>

            <!-- Carte 2 : Snacks & Bouchons Maison -->
            <a
                href="/nos-plats/samoussas-bouchons"
                class="group bg-sable rounded-2xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 border border-foret/5 flex flex-col"
            >
                <div class="overflow-hidden h-48 relative">
                    <Image
                        src={imgBouchons}
                        alt="Bouchons réunionnais porc combava faits maison et samoussas"
                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                        widths={[400, 800]}
                        sizes="(max-width: 768px) 100vw, 33vw"
                        loading="lazy"
                    />
                    <span
                        class="absolute top-3 left-3 bg-safran text-foret text-[10px] font-bold px-2.5 py-1 rounded-full uppercase tracking-wider"
                    >
                        100% Fait Maison
                    </span>
                </div>
                <div class="p-6 flex-1 flex flex-col justify-between">
                    <div>
                        <span
                            class="text-[10px] font-bold text-terracotta uppercase tracking-wider block mb-1"
                        >
                            Street-Food Créole
                        </span>
                        <h3
                            class="text-lg font-serif text-foret font-bold mb-2 group-hover:text-safran transition-colors"
                        >
                            Bouchons & Snacks Péi
                        </h3>
                        <p class="text-xs text-foret/70 leading-relaxed mb-4">
                            Bouchons porc/combava et poulet faits maison,
                            samoussas, accras de morue et bonbons piment.
                        </p>
                    </div>
                    <span
                        class="text-xs font-bold text-foret group-hover:translate-x-1 transition-transform inline-flex items-center gap-1"
                    >
                        La sélection apéro <span aria-hidden="true">→</span>
                    </span>
                </div>
            </a>

            <!-- Carte 3 : Service Traiteur & Événements -->
            <a
                href="/devis-traiteur"
                class="group bg-sable rounded-2xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 border border-foret/5 flex flex-col"
            >
                <div class="overflow-hidden h-48 relative">
                    <Image
                        src={imgMarche}
                        alt="Stand traiteur réunionnais La Cuisine du Mafatais sur le marché à Toulouse"
                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                        widths={[400, 800]}
                        sizes="(max-width: 768px) 100vw, 33vw"
                        loading="lazy"
                    />
                    <span
                        class="absolute top-3 left-3 bg-foret text-sable text-[10px] font-bold px-2.5 py-1 rounded-full uppercase tracking-wider"
                    >
                        Sur-Mesure
                    </span>
                </div>
                <div class="p-6 flex-1 flex flex-col justify-between">
                    <div>
                        <span
                            class="text-[10px] font-bold text-terracotta uppercase tracking-wider block mb-1"
                        >
                            Événementiel
                        </span>
                        <h3
                            class="text-lg font-serif text-foret font-bold mb-2 group-hover:text-safran transition-colors"
                        >
                            Prestations Traiteur
                        </h3>
                        <p class="text-xs text-foret/70 leading-relaxed mb-4">
                            Buffets créoles, mariages et repas d'entreprise
                            servis à la marmite partout en Haute-Garonne.
                        </p>
                    </div>
                    <span
                        class="text-xs font-bold text-foret group-hover:translate-x-1 transition-transform inline-flex items-center gap-1"
                    >
                        Demander un devis <span aria-hidden="true">→</span>
                    </span>
                </div>
            </a>
        </div>
    </div>
</section>

<!-- Données structurées pour le référencement Google & Moteurs IA -->
<script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "ItemList",
        "name": "Spécialités créoles réunionnaises à Toulouse",
        "itemListElement": [
            {
                "@type": "ListItem",
                "position": 1,
                "name": "Carrys, Rougails & Sautés",
                "url": "https://lacuisinedumafatais.fr/nos-plats/carrys-et-rougails"
            },
            {
                "@type": "ListItem",
                "position": 2,
                "name": "Sarcives & Grillades au fumoir",
                "url": "https://lacuisinedumafatais.fr/nos-plats/sarcives-fumoir"
            },
            {
                "@type": "ListItem",
                "position": 3,
                "name": "Bouchons & Snacks Péi faits maison",
                "url": "https://lacuisinedumafatais.fr/nos-plats/samoussas-bouchons"
            },
            {
                "@type": "ListItem",
                "position": 4,
                "name": "Prestations Traiteur Événementiel",
                "url": "https://lacuisinedumafatais.fr/devis-traiteur"
            }
        ]
    }
</script>
