---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

interface Props {
	title: string;
	description?: string;
	image?: string;
	type?: string;
}

const {
	title,
	description = "La Cuisine du Mafatais : Traiteur réunionnais & spécialiste des spécialités créoles sur les marchés de Toulouse et en Haute-Garonne (31). Carrys, Rougails, Sarcives & Samoussas faits maison.",
	image = "/images/logo.png",
	type = "website",
} = Astro.props;

const canonicalURL = new URL(
	Astro.url.pathname,
	Astro.site || "https://lacuisinedumafatais.fr",
);
---

<!doctype html>
<html lang="fr" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL} />

		<!-- Favicon -->
		<link rel="icon" type="image/png" href="/images/favicon.png" />
		<link rel="apple-touch-icon" href="/images/favicon.png" />

		<!-- Open Graph / Facebook / WhatsApp / LinkedIn -->
		<meta property="og:type" content={type} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={new URL(image, canonicalURL)} />
		<meta property="og:locale" content="fr_FR" />
		<meta property="og:site_name" content="La Cuisine du Mafatais" />

		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={new URL(image, canonicalURL)} />

		<!-- Balisage Géographique Local -->
		<meta name="geo.region" content="FR-31" />
		<meta name="geo.placename" content="Toulouse" />
		<meta name="geo.position" content="43.604652;1.444209" />
		<meta name="ICBM" content="43.604652, 1.444209" />

		<meta name="generator" content={Astro.generator} />
	</head>
	<body
		class="bg-sable text-foret font-sans antialiased selection:bg-safran selection:text-foret min-h-screen flex flex-col justify-between"
	>
		<Navbar />
		<div class="flex-grow">
			<slot />
		</div>
		<Footer />
	</body>
</html>
