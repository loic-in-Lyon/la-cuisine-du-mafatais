---
import Layout from "../../layouts/Layout.astro";
import { Image } from "astro:assets";

// Imports d'images optimisés depuis le dossier src/assets/images/
import imgBouchons from "../../assets/images/bouchons.jpg";
import imgSamoussas from "../../assets/images/samoussas.jpeg";
import imgAcras from "../../assets/images/acras.jpg";
import imgBonbonPiment from "../../assets/images/bonbon-piment.jpg";
---

<Layout
    title="Bouchons Maison, Samoussas & Snacks Créoles à Toulouse | La Cuisine du Mafatais"
    description="Bouchons artisanaux (porc/combava, poulet), samoussas croustillants, accras de morue et bonbons piment faits maison à Toulouse. Vente sur le marché et traiteur."
>
    <main class="py-12 md:py-20">
        <div class="max-w-7xl mx-auto px-6">
            <!-- Fil d'Ariane Sémantique -->
            <nav
                aria-label="Fil d'Ariane"
                class="text-xs text-foret/60 mb-8 flex items-center gap-2"
            >
                <a href="/" class="hover:text-safran transition-colors"
                    >Accueil</a
                >
                <span aria-hidden="true">/</span>
                <a href="/#carte" class="hover:text-safran transition-colors"
                    >Nos Plats</a
                >
                <span aria-hidden="true">/</span>
                <span class="text-foret font-semibold" aria-current="page"
                    >Snacks & Street-Food Créole</span
                >
            </nav>

            <!-- En-tête -->
            <header class="max-w-3xl mb-16">
                <!-- Eyebrow uniformisé sur fond pastille accessible -->
                <span
                    class="text-xs font-extrabold text-foret bg-safran/30 px-3.5 py-1.5 rounded-full uppercase tracking-widest inline-block mb-3 shadow-sm"
                >
                    100% Fait Maison
                </span>
                <h1
                    class="text-3xl md:text-5xl font-serif font-bold text-foret leading-tight mb-4"
                >
                    Bouchons, Samoussas & Snacks Péi
                </h1>
                <p class="text-lg text-foret/80 font-light leading-relaxed">
                    Incontournables de l'apéro et de la street-food
                    réunionnaise, tous nos snacks sont façonnés à la main. À
                    déguster chauds sur le pouce au marché ou en pièces
                    apéritives pour vos événements.
                </p>
            </header>

            <!-- Grille des Snacks -->
            <div class="grid md:grid-cols-2 gap-8 mb-20">
                <!-- Snack 1 : Bouchons Fait Maison -->
                <article
                    class="bg-sable-dark/30 rounded-3xl p-6 md:p-8 border border-foret/5 flex flex-col justify-between"
                >
                    <div>
                        <div
                            class="rounded-2xl overflow-hidden h-56 mb-6 shadow-md"
                        >
                            <Image
                                src={imgBouchons}
                                alt="Bouchons réunionnais faits maison porc et combava"
                                class="w-full h-full object-cover"
                                widths={[400, 800]}
                                sizes="(max-width: 768px) 100vw, 50vw"
                                loading="eager"
                            />
                        </div>
                        <span
                            class="px-3 py-1 bg-safran text-foret text-[10px] font-bold uppercase tracking-widest rounded-full inline-block mb-3"
                        >
                            Spécialité Phare
                        </span>
                        <h2
                            class="text-2xl font-serif font-bold text-foret mb-2"
                        >
                            Bouchons Artisanaux (Fait Maison)
                        </h2>
                        <p class="text-sm text-foret/80 leading-relaxed mb-4">
                            Bouchées à la vapeur enveloppées dans une pâte fine
                            et farcies de viande assaisonnée au combava frais ou
                            au poulet. Servis avec sauce soja et piment chinois.
                        </p>
                    </div>
                    <div
                        class="pt-4 border-t border-foret/10 flex justify-between items-center text-xs"
                    >
                        <span class="text-foret/70 font-semibold"
                            >Variétés : Porc / Combava ou Poulet</span
                        >
                        <!-- Prix sobre, net et bien contrasté en foret et bold -->
                        <span class="text-foret font-bold text-sm">
                            1 € / pièce
                        </span>
                    </div>
                </article>

                <!-- Snack 2 : Samoussas -->
                <article
                    class="bg-sable-dark/30 rounded-3xl p-6 md:p-8 border border-foret/5 flex flex-col justify-between"
                >
                    <div>
                        <div
                            class="rounded-2xl overflow-hidden h-56 mb-6 shadow-md"
                        >
                            <Image
                                src={imgSamoussas}
                                alt="Samoussas réunionnais croustillants garnis"
                                class="w-full h-full object-cover"
                                widths={[400, 800]}
                                sizes="(max-width: 768px) 100vw, 50vw"
                                loading="lazy"
                            />
                        </div>
                        <span
                            class="px-3 py-1 bg-terracotta text-white text-[10px] font-bold uppercase tracking-widest rounded-full inline-block mb-3 shadow-sm"
                        >
                            Croustillant & Parfumé
                        </span>
                        <h2
                            class="text-2xl font-serif font-bold text-foret mb-2"
                        >
                            Samoussas Créoles
                        </h2>
                        <p class="text-sm text-foret/80 leading-relaxed mb-4">
                            Triangles croustillants généreusement garnis de
                            farce épicée. Recette traditionnelle pliée à la main
                            pour une texture parfaite après cuisson.
                        </p>
                    </div>
                    <div
                        class="pt-4 border-t border-foret/10 flex justify-between items-center text-xs"
                    >
                        <span class="text-foret/70 font-semibold"
                            >Bœuf ou Jambon / Gruyère</span
                        >
                        <span class="text-foret font-bold text-sm">
                            5 € les 4 / 10 € les 10
                        </span>
                    </div>
                </article>

                <!-- Snack 3 : Accras de Morue -->
                <article
                    class="bg-sable-dark/30 rounded-3xl p-6 md:p-8 border border-foret/5 flex flex-col justify-between"
                >
                    <div>
                        <div
                            class="rounded-2xl overflow-hidden h-56 mb-6 shadow-md"
                        >
                            <Image
                                src={imgAcras}
                                alt="Accras de morue dorés et moelleux faits maison"
                                class="w-full h-full object-cover"
                                widths={[400, 800]}
                                sizes="(max-width: 768px) 100vw, 50vw"
                                loading="lazy"
                            />
                        </div>
                        <span
                            class="px-3 py-1 bg-foret text-sable text-[10px] font-bold uppercase tracking-widest rounded-full inline-block mb-3 shadow-sm"
                        >
                            Incontournable Apéro
                        </span>
                        <h2
                            class="text-2xl font-serif font-bold text-foret mb-2"
                        >
                            Accras de Morue
                        </h2>
                        <p class="text-sm text-foret/80 leading-relaxed mb-4">
                            Beignets dorés et moelleux préparés avec de la morue
                            effilochée, des herbes fraîches, de l'oignon pays et
                            une pointe d'épices doux.
                        </p>
                    </div>
                    <div
                        class="pt-4 border-t border-foret/10 flex justify-between items-center text-xs"
                    >
                        <span class="text-foret/70 font-semibold"
                            >Portion de 8 pièces</span
                        >
                        <span class="text-foret font-bold text-sm">
                            6 € les 8
                        </span>
                    </div>
                </article>

                <!-- Snack 4 : Bonbons Piment -->
                <article
                    class="bg-sable-dark/30 rounded-3xl p-6 md:p-8 border border-foret/5 flex flex-col justify-between"
                >
                    <div>
                        <div
                            class="rounded-2xl overflow-hidden h-56 mb-6 shadow-md"
                        >
                            <Image
                                src={imgBonbonPiment}
                                alt="Bonbons piment réunionnais traditionnels aux pois du cap"
                                class="w-full h-full object-cover"
                                widths={[400, 800]}
                                sizes="(max-width: 768px) 100vw, 50vw"
                                loading="lazy"
                            />
                        </div>
                        <span
                            class="px-3 py-1 bg-safran text-foret text-[10px] font-bold uppercase tracking-widest rounded-full inline-block mb-3 shadow-sm"
                        >
                            100% Végétalien
                        </span>
                        <h2
                            class="text-2xl font-serif font-bold text-foret mb-2"
                        >
                            Bonbons Piment
                        </h2>
                        <p class="text-sm text-foret/80 leading-relaxed mb-4">
                            Galettes frite à base de pois du Cap concassés,
                            cumin, curcuma, gingembre, piment vert et
                            ciboulette. Un classique relevé et croustillant.
                        </p>
                    </div>
                    <div
                        class="pt-4 border-t border-foret/10 flex justify-between items-center text-xs"
                    >
                        <span class="text-foret/70 font-semibold"
                            >Portion de 8 pièces</span
                        >
                        <span class="text-foret font-bold text-sm">
                            6 € les 8
                        </span>
                    </div>
                </article>
            </div>

            <!-- Call to action -->
            <section
                class="p-8 md:p-12 rounded-3xl bg-foret text-sable text-center max-w-4xl mx-auto shadow-2xl"
            >
                <h3 class="text-2xl md:text-3xl font-serif font-bold mb-4">
                    Un cocktail ou un apéritif en vue ?
                </h3>
                <p
                    class="text-sable/80 text-sm md:text-base max-w-xl mx-auto mb-8 font-light"
                >
                    Composez votre plateau apéritif créole sur-mesure pour vos
                    fêtes, anniversaires ou événements d'entreprise.
                </p>
                <div class="flex flex-col sm:flex-row justify-center gap-4">
                    <a
                        href="/devis-traiteur"
                        class="px-8 py-4 bg-safran text-foret font-bold rounded-full hover:bg-safran/90 transition-all text-sm shadow-md"
                    >
                        Demander un devis apéritif / traiteur
                    </a>
                    <a
                        href="/#marches"
                        class="px-8 py-4 bg-sable text-foret font-semibold rounded-full hover:bg-white transition-all text-sm shadow-md"
                    >
                        Voir nos marchés
                    </a>
                </div>
            </section>
        </div>
    </main>
</Layout>

<!-- JSON-LD SEO Local & Menu Items avec Tarifs -->
<script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@graph": [
            {
                "@type": "BreadcrumbList",
                "itemListElement": [
                    {
                        "@type": "ListItem",
                        "position": 1,
                        "name": "Accueil",
                        "item": "https://lacuisinedumafatais.fr"
                    },
                    {
                        "@type": "ListItem",
                        "position": 2,
                        "name": "Nos Plats",
                        "item": "https://lacuisinedumafatais.fr/#carte"
                    },
                    {
                        "@type": "ListItem",
                        "position": 3,
                        "name": "Snacks & Street-Food Créole",
                        "item": "https://lacuisinedumafatais.fr/nos-plats/samoussas-bouchons"
                    }
                ]
            },
            {
                "@type": "Menu",
                "name": "Snacks, Bouchons & Street-Food Réunionnaise",
                "hasMenuItem": [
                    {
                        "@type": "MenuItem",
                        "name": "Bouchons Artisanaux",
                        "description": "Bouchées à la vapeur porc/combava ou poulet.",
                        "offers": {
                            "@type": "Offer",
                            "price": "1.00",
                            "priceCurrency": "EUR"
                        }
                    },
                    {
                        "@type": "MenuItem",
                        "name": "Samoussas Créoles",
                        "description": "Triangles croustillants bœuf ou jambon/gruyère.",
                        "offers": {
                            "@type": "Offer",
                            "price": "5.00",
                            "priceCurrency": "EUR"
                        }
                    },
                    {
                        "@type": "MenuItem",
                        "name": "Accras de Morue",
                        "description": "Portion de 8 beignets dorés de morue.",
                        "offers": {
                            "@type": "Offer",
                            "price": "6.00",
                            "priceCurrency": "EUR"
                        }
                    },
                    {
                        "@type": "MenuItem",
                        "name": "Bonbons Piment",
                        "description": "Portion de 8 galettes de pois du cap épicées.",
                        "offers": {
                            "@type": "Offer",
                            "price": "6.00",
                            "priceCurrency": "EUR"
                        }
                    }
                ]
            }
        ]
    }
</script>
